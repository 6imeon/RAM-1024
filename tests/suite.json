{
  "_doc": [
    "Test/analysis suite for tools/suite.py. Order = priority: correctness",
    "first, then hardening, then cryptanalysis. tier: quick < standard < full",
    "< proof (open research runs; only with --tier proof or --only). A tier",
    "runs every job of the tiers below it. est/max: expected and",
    "maximum seconds. A job starts only if est fits in the time left; it is",
    "killed at min(max, deadline). pool 'local' jobs run one at a time,",
    "'docker' jobs run one at a time beside them (each uses half the cores).",
    "{slot} in cmd = the seconds this job is allowed. needs = tools that",
    "must be on PATH, else the job is skipped (reported, not failed).",
    "env: extra variables ({ncpu} = core count), e.g. to give a proof job",
    "every core. superseded_by: skipped when that job is also selected",
    "(it covers this one)."
  ],
  "jobs": [
    {"id": "build",          "tier": "quick", "pool": "local", "est": 15,  "max": 300,
     "needs": ["make", "cc"], "cmd": ["make", "all", "lab"]},
    {"id": "c-conformance",  "tier": "quick", "pool": "local", "est": 5,   "max": 120,
     "needs": ["make", "cc"], "cmd": ["make", "check"]},
    {"id": "python-suite",   "tier": "quick", "pool": "local", "est": 10,  "max": 300,
     "cmd": ["{python}", "-m", "unittest", "discover", "-s", "tests"]},
    {"id": "c-vs-python-xcheck", "tier": "quick", "pool": "local", "est": 5, "max": 120,
     "cmd": ["{python}", "tools/xcheck.py", "2000"]},
    {"id": "kat-reference",  "tier": "quick", "pool": "local", "est": 20,  "max": 300,
     "needs": ["make"], "cmd": ["make", "reference"]},
    {"id": "xplat-quick",    "tier": "quick", "pool": "docker", "est": 120, "max": 900,
     "superseded_by": "xplat-all",
     "needs": ["docker", "sh"], "cmd": ["sh", "tools/crossplatform.sh", "quick"]},

    {"id": "native-sanitizers", "tier": "standard", "pool": "local", "est": 40, "max": 600,
     "needs": ["sh", "cc"], "cmd": ["sh", "tools/native_sanitizers.sh"]},
    {"id": "perm-attack",    "tier": "standard", "pool": "local", "est": 90,  "max": 600,
     "cmd": ["{python}", "analysis/perm_attack.py", "v3"]},
    {"id": "algebraic",      "tier": "standard", "pool": "local", "est": 15,  "max": 300,
     "cmd": ["{python}", "analysis/algebraic.py", "v3"]},
    {"id": "trail-search",   "tier": "standard", "pool": "local", "est": 600, "max": 1200,
     "needs": ["cc"], "cmd": ["{python}", "analysis/trail_search.py", "12", "{restarts}"]},
    {"id": "xplat-all",      "tier": "full", "pool": "docker", "est": 1200, "max": 2400,
     "needs": ["docker", "sh"], "cmd": ["sh", "tools/crossplatform.sh", "all"]},
    {"id": "sat-attack",     "tier": "standard", "pool": "docker", "est": 400, "max": 900,
     "needs": ["docker", "sh"],
     "cmd": ["sh", "tools/dockrun.sh", "python3", "analysis/sat_attack.py", "60"]},
    {"id": "trail-bounds-3", "tier": "standard", "pool": "docker", "est": 300, "max": 900,
     "superseded_by": "trail-bounds-4",
     "needs": ["docker", "sh"],
     "cmd": ["sh", "tools/dockrun.sh", "python3", "analysis/trail_bounds.py", "{slot}", "3"]},

    {"id": "run-all",        "tier": "full", "pool": "local", "est": 400, "max": 900,
     "cmd": ["{python}", "analysis/run_all.py"]},
    {"id": "redteam",        "tier": "full", "pool": "local", "est": 400, "max": 900,
     "cmd": ["{python}", "analysis/redteam.py"]},
    {"id": "calibrate",      "tier": "full", "pool": "local", "est": 130, "max": 600,
     "cmd": ["{python}", "analysis/calibrate.py"]},
    {"id": "robustness",     "tier": "full", "pool": "local", "est": 120, "max": 600,
     "cmd": ["{python}", "analysis/robustness.py"]},
    {"id": "rotational",     "tier": "full", "pool": "local", "est": 60,  "max": 300,
     "cmd": ["{python}", "analysis/rotational.py"]},
    {"id": "grover",         "tier": "full", "pool": "local", "est": 60,  "max": 300,
     "cmd": ["{python}", "analysis/grover.py"]},
    {"id": "trail-bounds-linear", "tier": "full", "pool": "docker", "est": 600, "max": 1800,
     "needs": ["docker", "sh"],
     "cmd": ["sh", "tools/dockrun.sh", "python3", "analysis/trail_bounds.py", "linear", "{slot}", "4", "64"]},
    {"id": "trail-bounds-4", "tier": "full", "pool": "docker", "est": 600, "max": 1800,
     "needs": ["docker", "sh"],
     "cmd": ["sh", "tools/dockrun.sh", "python3", "analysis/trail_bounds.py", "{slot}", "4"]},
    {"id": "trail-proof-6",  "tier": "proof", "pool": "docker", "est": 1800, "max": 3300,
     "needs": ["docker", "sh"], "env": {"RAM_THREADS": "{ncpu}"},
     "cmd": ["sh", "tools/dockrun.sh", "python3", "analysis/trail_bounds.py", "check", "6", "34", "{slot}"]}
  ]
}
